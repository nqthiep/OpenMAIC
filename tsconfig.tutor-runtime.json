{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "removeComments": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib/tutor/runtime/**/*.ts"],
  "exclude": ["node_modules"]
}
