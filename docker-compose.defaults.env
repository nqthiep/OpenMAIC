# Defaults for the OpenMAIC service in docker-compose.yml. Compose reads this
# file before .env.local, so any key set in .env.local overrides the value here.
# See README "Docker Deployment" and .env.example for each setting.
# Compose interpolates ${...} here from your shell or a .env file next to
# docker-compose.yml (not from .env.local).

# Server-backed persistence against the bundled postgres service. Set your own
# DATABASE_URL in .env.local to use an external database (the bundled postgres
# service still starts, unused) or a password with characters that need URL
# encoding. PERSISTENCE_POSTGRES_PASSWORD must be letters and digits here, since
# it is inserted into the URL unencoded.
DATABASE_URL=postgres://openmaic:${PERSISTENCE_POSTGRES_PASSWORD:-openmaic-dev}@postgres:5432/openmaic

# KHAITAM serves many people with their own accounts, so the single-user owner (one fixed owner for a
# personal installation, upstream's default) is off here: with it on, every request would be one
# owner. Set OWNER_SINGLE_USER=true in .env.local only for a personal installation.
OWNER_SINGLE_USER=false
# OWNER_SINGLE_USER_ID=local

# What a visitor made before signing in moves into the account on the first request after sign-in
# (the owner identity seam's automatic claim). KHAITAM's pages never call POST /api/identity/claim,
# which is what "explicit" would need. Set "explicit" in .env.local to move nothing.
OWNER_CLAIM_TRIGGER=auto

# Single-user mode runs with or without ACCESS_CODE. Without one, anyone who
# can reach the app is the single owner, so docker-compose.yml publishes it on
# 127.0.0.1 only and the app logs a warning at startup. Set ACCESS_CODE in
# .env.local before publishing it anywhere else.
